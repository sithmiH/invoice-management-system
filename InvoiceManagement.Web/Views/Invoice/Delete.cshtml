@model InvoiceManagement.Web.DTOs.Invoice.InvoiceResponseDto

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container mt-4">

    <div class="card border-danger shadow">

        <div class="card-header bg-danger text-white">
            <h3>Delete Invoice</h3>
        </div>

        <div class="card-body">

            <p class="text-danger">
                Are you sure you want to delete this invoice?
            </p>

            <dl class="row">

                <dt class="col-sm-4">Invoice Number</dt>
                <dd class="col-sm-8">@Model.InvoiceNumber</dd>

                <dt class="col-sm-4">Customer</dt>
                <dd class="col-sm-8">@Model.CustomerName</dd>

                <dt class="col-sm-4">Amount</dt>
                <dd class="col-sm-8">@Model.Amount</dd>

            </dl>

            <form asp-action="Delete" asp-route-id="@Model.InvoiceId">

                <input type="hidden"
                       asp-for="InvoiceId" />

                <button class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
