@using Microsoft.AspNetCore.Http

@model List<InvoiceManagement.Web.DTOs.Invoice.InvoiceResponseDto>

@{
    ViewData["Title"] = "Invoices";
}

@* Invoices list page *@
<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <h4 class="mb-0">Invoices</h4>

            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a asp-action="Create"
                   class="btn btn-light">
                    + Create Invoice
                </a>
            }

        </div>

        <div class="card-body">

    @if (Model != null && Model.Any())
{

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>
                <th>Invoice No</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var invoice in Model)
            {
                <tr>

                    <td>@invoice.InvoiceNumber</td>

                    <td>@invoice.CustomerName</td>

                    <td>@invoice.Amount.ToString("C")</td>

                    <td>

                        @if (invoice.Status == "Paid")
                        {
                            <span class="badge bg-success">Paid</span>
                        }
                        else if (invoice.Status == "Draft")
                        {
                            <span class="badge bg-warning text-dark">Draft</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }

                    </td>

                    <td>@invoice.CreatedDate.ToShortDateString()</td>

                    <td>

                        <a asp-action="Details" 
                           asp-route-id="@invoice.InvoiceId" 
                           class="btn btn-info btn-sm me-1"> Details 
                        </a>

                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <a asp-action="Edit"
                               asp-route-id="@invoice.InvoiceId"
                               class="btn btn-warning btn-sm me-1">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@invoice.InvoiceId"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

            }
            else
            {
                <div class="alert alert-info">
                    No invoices found.
                </div>
            }

</div>


