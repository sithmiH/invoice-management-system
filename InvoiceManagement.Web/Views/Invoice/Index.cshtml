@using Microsoft.AspNetCore.Http

@model List<InvoiceManagement.Web.DTOs.Invoice.InvoiceResponseDto>

@{
    ViewData["Title"] = "Invoices";
}

@* Invoices list page *@
<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <h4 class="mb-0">Invoices</h4>

            @if (Context.Session.GetString("Role") == "Admin")
            {
                <a asp-action="Create"
                   class="btn btn-light">
                    + Create Invoice
                </a>
            }

        </div>

        <div class="card-body">

    @if (Model != null && Model.Any())
{
                @* Search functionality- only for Admins *@
                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <div class="row mb-3">

                    <div class="col-md-12">

                        <form asp-action="Index" method="get">

                            <div class="input-group">

                                <input 
                                       name="invoiceId"
                                       class="form-control"
                                       placeholder="Search Invoice ID" />

                                <button class="btn btn-primary" type="submit">
                                        <i class="bi bi-search"></i>
                                </button>

                                    <a asp-action="Index"
                                       class="btn btn-outline-secondary"
                                       title="Refresh">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </a>

                            </div>

                        </form>

                    </div>

                </div> 
                }

    @* Invoice table *@
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>
                <th>Invoice No</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var invoice in Model)
            {
                <tr>

                    <td>@invoice.InvoiceNumber</td>

                    <td>@invoice.CustomerName</td>

                    <td>@invoice.Amount.ToString("C")</td>

                    <td>

                        @if (invoice.Status == "Paid")
                        {
                            <span class="badge bg-success">Paid</span>
                        }
                        else if (invoice.Status == "Draft")
                        {
                            <span class="badge bg-warning text-dark">Draft</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }

                    </td>

                    <td>@invoice.CreatedDate.ToShortDateString()</td>

                    <td>

                        @* View invoice details *@
                        <a asp-action="Details" 
                           asp-route-id="@invoice.InvoiceId" 
                           class="btn btn-info btn-sm me-1"> Details 
                        </a>

                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                                        @* Edit and delete options *@
                                        <a asp-action="Edit"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="btn btn-outline-warning btn-sm"
                                           title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@invoice.InvoiceId"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    title="Delete"
                                                    onclick="return confirm('Are you sure you want to delete this invoice?');">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

            }
            else
            {
                @* Display when no invoices are available *@
                <div class="alert alert-info">
                    No invoices found.
                </div>
            }

</div>


